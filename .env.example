# ============================================
# Chai Sutta - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chaisutta
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM Providers (Free Tiers) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Twitter/X (Burner Account) ---
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# --- Reddit (Free API) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=chai-sutta:v1.0

# --- TomTom (Free Tier: 2500/day) ---
TOMTOM_API_KEY=

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# --- Qdrant Vector DB ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
